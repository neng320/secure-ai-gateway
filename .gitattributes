# 行尾规范化：Go/Shell 一律 LF（gofmt 与 bash 脚本硬性要求）
*.go  text eol=lf
*.sh  text eol=lf

# Windows 专用脚本保持 CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# 常见文本类型自动规范化
*.md   text
*.yml  text
*.yaml text
*.json text
*.mod  text
*.sum  text
*.sql  text
*.html text
*.css  text
*.tmpl text

# 二进制文件不做转换
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
